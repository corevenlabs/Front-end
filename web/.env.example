# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local a git.

# --- Demo con IA (fase 3) ---
# Llave de la API de Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Modelo del agente de la demo. Por defecto claude-haiku-5-5 (rápido y barato).
# Alternativa de más calidad y unas 40 veces más cara por mensaje: claude-opus-5-5.
ANTHROPIC_MODEL=claude-haiku-5-5
# Mensajes con IA por visitante al día, y tope total diario (freno de gasto).
DEMO_LIMITE_VISITANTE=20
DEMO_LIMITE_DIARIO=400
# Texto aleatorio para anonimizar las IP en el contador de la demo. Generar uno propio.
DEMO_SAL=

# --- Base de datos (la misma de Neon que usa prospecting-bot) ---
DATABASE_URL=

# --- Avisos de contacto (fase 4) ---
RESEND_API_KEY=
AVISOS_PARA=corevenlabs@gmail.com
AVISOS_DESDE=onboarding@resend.dev

# --- Admin (fase 5) ---
ADMIN_USUARIO=
ADMIN_CLAVE_HASH=
ADMIN_SECRETO_SESION=

# Opcional: código de verificación de Google Search Console (método «Etiqueta HTML», solo el valor de content)
GOOGLE_SITE_VERIFICATION=
